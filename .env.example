# ===============================================================
#  Spotify Deck - 환경변수 예시
# ===============================================================
#  사용법:
#    1. 이 파일을 복사해서 .env 로 이름을 바꾼다.
#         copy .env.example .env
#    2. 아래 SPOTIFY_CLIENT_ID 값을 본인 것으로 채운다.
#    3. .env 는 .gitignore에 등록되어 있으므로 커밋되지 않는다.
# ===============================================================

# ---------------------------------------------------------------
#  [필수] Spotify Developer Dashboard에서 발급받은 Client ID
#  https://developer.spotify.com/dashboard
# ---------------------------------------------------------------
SPOTIFY_CLIENT_ID=여기에_본인의_Client_ID를_붙여넣으세요

# ---------------------------------------------------------------
#  [필수] Redirect URI
#
#  ⚠️ 중요: Spotify는 2025년부터 'localhost' 를 금지했습니다.
#     반드시 명시적 루프백 IP(127.0.0.1)를 사용해야 합니다.
#     이 값은 Dashboard에 등록한 값과 '글자 하나까지' 같아야 합니다.
# ---------------------------------------------------------------
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ---------------------------------------------------------------
#  [선택] Client Secret
#
#  이 앱은 PKCE(Proof Key for Code Exchange) 방식을 사용하므로
#  Client Secret이 필요 없습니다. 비워두세요.
#  데스크톱 앱은 Secret을 안전하게 숨길 수 없기 때문에
#  Spotify가 네이티브 앱에 PKCE를 권장합니다.
# ---------------------------------------------------------------
# SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------
#  [선택] 동작 튜닝
# ---------------------------------------------------------------

# 재생 정보 자동 갱신 주기 (밀리초). 기본 1000ms.
# 너무 낮추면 API Rate Limit에 걸릴 수 있습니다. 최소 500ms 권장.
DECK_POLL_INTERVAL_MS=1000

# 토큰 저장 방식: auto | keyring | file
#   auto    - keyring을 시도하고 실패하면 file로 폴백 (기본값)
#   keyring - OS 자격 증명 저장소 강제 (Windows 자격 증명 관리자)
#   file    - 파일에 저장 강제 (헤드리스 RK3399 등에서 사용)
DECK_TOKEN_STORE=auto

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
DECK_LOG_LEVEL=INFO

# 웨이브 바(스펙트럼) 표시 방식
#   auto      - 이 PC 소리를 캡처해 실시간 반응. 소리가 없으면 자동으로 시뮬레이션 (기본)
#   live      - 실시간 캡처 강제
#   simulated - 시뮬레이션만 사용 (soundcard 불필요)
#   off       - 웨이브 바 숨김
DECK_WAVE_MODE=auto
